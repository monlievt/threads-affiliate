# ===========================================================================
# THREADS AFFILIATE AUTOMATION — .gitignore
# ===========================================================================

# --- 1. SECRETS & LOCAL ENVIRONMENT (MUTLAK JANGAN DIUPLOAD) ---
.env
.env.*
*.env
!.env.example

# --- 2. DATABASE & OPERATIONAL DATA (FAIL-CLOSED SAFETY) ---
data/
*.db
*.db-wal
*.db-shm
*.db.sha256
*.sqlite
*.sqlite3
backup/
backups/

# --- 3. LOGS & RUNTIME SCRATCH ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 4. PYTHON / VIRTUAL ENVIRONMENTS ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- 5. NODE.JS & NEXT.JS BUILD ARTIFACTS ---
node_modules/
.next/
out/
*.tsbuildinfo
playwright-report/
test-results/

# --- 6. OPERATING SYSTEM ARTIFACTS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- 7. IDE & EDITORS ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- 8. MIGRATIONS & GENERATED CODE ---
backend/app/db/migrations/versions/
