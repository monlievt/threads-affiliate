# ===== App =====
APP_ENV=production
APP_TIMEZONE=Asia/Jakarta
SECRET_KEY=change-me-long-random
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=argon2-hash-here
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# ===== Threads (Meta) =====
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://your-domain/api/oauth/threads/callback
THREADS_API_BASE=https://graph.threads.net/v1.0
# token disimpan terenkripsi di DB, bukan di sini
TOKEN_ENCRYPTION_KEY=base64-32-bytes
# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# ===== LLM (Gemini Pro — tier berbayar) =====
GEMINI_API_KEY=
GEMINI_MODEL_TEXT=gemini-2.5-pro   # [VERIFIKASI] nama model terbaru; gunakan Pro bukan Flash untuk privasi dan kualitas
LLM_DAILY_CALL_BUDGET=200          # safety net; bukan karena kuota ketat
# ===== Safety (batas keras; jangan dinaikkan tanpa alasan) =====
HARD_MAX_POSTS_PER_DAY=8
HARD_MAX_REPLIES_PER_DAY=10
KILL_SWITCH_ON_START=true
